# Server-only settings. Never prefix these keys with VITE_.
# Fresh clones start with sample answers. Your existing .env is unchanged.
# For your configured company assistant, use AI_MODE=gemini-chat.
AI_MODE=demo
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_DRIVE_FOLDER_ID=
# Optional persistent private location. Defaults to .cache/chat/conversations.sqlite
# CHAT_DATABASE_PATH=C:/private/onboardai/conversations.sqlite
HOST=127.0.0.1
PORT=3000
# Warm the installed Kokoro model at startup for an earlier first spoken answer.
VOICE_WARMUP=true
