# Server-only settings. Never prefix these keys with VITE_.
# Fresh clones start with sample answers. Your existing .env is unchanged.
# For your configured company assistant, use AI_MODE=gemini-chat.
AI_MODE=demo
# Gemini runs on Vertex AI with Application Default Credentials (no API key).
# Locally run: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Legacy billed Cloud Text-to-Speech route; off by default, local use only.
# GOOGLE_CLOUD_TTS=enabled
GEMINI_MODEL=gemini-3.5-flash-lite
# Company documents: Vertex AI Search chunk search (same project and credentials).
# Leave the engine ID blank to answer from the built-in sample onboarding guide.
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_ENGINE_ID=
# Saved chats: blank keeps them in local SQLite (.cache/chat/conversations.sqlite).
# (default) stores them in Firestore in GOOGLE_CLOUD_PROJECT, with the same credentials.
FIRESTORE_DATABASE_ID=
# Optional persistent private SQLite location when FIRESTORE_DATABASE_ID is blank.
# CHAT_DATABASE_PATH=C:/private/onboardai/conversations.sqlite
HOST=127.0.0.1
PORT=3000
