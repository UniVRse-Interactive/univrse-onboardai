# Server-only settings. Never prefix these keys with VITE_.
# Fresh clones start with sample answers. Your existing .env is unchanged.
# For the supplied ALYA brain, set AI_MODE=alya-brain and GEMINI_API_KEY.
AI_MODE=demo
# Replacement brain uses the Gemini API with a server-only key.
GEMINI_API_KEY=
# Legacy Vertex mode (AI_MODE=gemini-chat) and Google Drive use ADC.
# For Drive access locally: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Legacy billed Cloud Text-to-Speech route; off by default, local use only.
# GOOGLE_CLOUD_TTS=enabled
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_DRIVE_FOLDER_ID=
# Local HR imports can move Google Docs into this folder. Requires Drive write
# credentials and source/folder edit access. Disabled for public/production access
# until verified HR authentication is implemented.
# GOOGLE_DRIVE_DOCUMENT_MOVES=enabled
# Optional persistent private location. Defaults to .cache/chat/conversations.sqlite
# CHAT_DATABASE_PATH=C:/private/onboardai/conversations.sqlite
HOST=127.0.0.1
PORT=3000
# Warm the installed Kokoro model at startup for an earlier first spoken answer.
VOICE_WARMUP=true
