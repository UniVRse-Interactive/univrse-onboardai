# Server-only settings. Never prefix these keys with VITE_.
# Fresh clones start with sample answers. Your existing .env is unchanged.
# For your configured company assistant, use AI_MODE=gemini-chat.
AI_MODE=demo
# Gemini runs on Vertex AI with Application Default Credentials (no API key).
# Locally run: gcloud auth application-default login
# GOOGLE_CLOUD_PROJECT is required for every Gemini feature (answers, autofill, the Gemini
# voice, the checklist agent); npm run local falls back to `gcloud config get-value project`.
# With accounts on (DATABASE_URL), the project also enables HR profile autofill:
# Gemini pre-fills the employee forms from an uploaded CV, offer letter or form.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Legacy billed Cloud Text-to-Speech route; off by default, local use only.
# GOOGLE_CLOUD_TTS=enabled
GEMINI_MODEL=gemini-3.5-flash-lite
# Company documents: Vertex AI Search chunk search (same project and credentials).
# Leave the engine ID blank to answer from the built-in sample onboarding guide.
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_ENGINE_ID=
# Saved chats: blank keeps them in local SQLite (.cache/chat/conversations.sqlite).
# (default) stores them in Firestore in FIRESTORE_PROJECT_ID (or GOOGLE_CLOUD_PROJECT),
# with the same credentials. Employee accounts require it.
FIRESTORE_DATABASE_ID=
# Firestore project for saved chats and employee profiles. Blank uses GOOGLE_CLOUD_PROJECT.
# Locally use demo-onboardai, the project the Firestore emulator in compose.yaml keeps.
FIRESTORE_PROJECT_ID=
# Local Firestore emulator (npm run db:up). Required for accounts outside Cloud Run, so
# test personal data never reaches a cloud database. Locally: 127.0.0.1:8681
FIRESTORE_EMULATOR_HOST=
# HR and employee accounts: PostgreSQL connection URL. Blank turns accounts off.
# Local (compose.yaml): postgresql://onboardai:onboardai_local@127.0.0.1:5442/onboardai
# Then: npm run db:up, npm run db:migrate, npm run hr:create. Never commit a real password.
DATABASE_URL=
# Which databases `npm run db:migrate` migrates: sql, firestore or sql,firestore. Leave blank
# locally to migrate every configured one. A listed target needs its variable (DATABASE_URL,
# FIRESTORE_DATABASE_ID), otherwise the run stops before touching a database.
# DATABASE_URL may also be the Cloud SQL socket form:
# postgresql://USER:PASS@/DB?host=/cloudsql/PROJECT:REGION:INSTANCE
MIGRATION_TARGETS=
# Optional persistent private SQLite location when FIRESTORE_DATABASE_ID is blank.
# CHAT_DATABASE_PATH=C:/private/onboardai/conversations.sqlite
HOST=127.0.0.1
PORT=3000
# Cloud Run only: service-to-service ID tokens (X-Serverless-Authorization) for the
# web -> api and api -> tts calls. Leave unset: it turns on by itself on Cloud Run with
# https service URLs and stays off locally. none = never, id-token = always (https only).
# SERVICE_AUTH=
# Warm the installed Kokoro model at startup for an earlier first spoken answer.
VOICE_WARMUP=true
# Alya's voice: kokoro (default) or gemini (Gemini text to speech on Vertex AI, with the
# same project and credentials; Kokoro stays the fallback). gemini-3.8-flash-tts is Preview.
VOICE_PROVIDER=kokoro
# GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# GEMINI_TTS_LOCATION=global
# GEMINI_TTS_VOICE=Sulafat

# Onboarding checklist agent (#51): start it with npm run checklist-agent (needs uv and the
# Firestore emulator), then point the api at it. npm run local runs it as a container and
# sets CHECKLIST_AGENT_URL=http://checklist-agent:8093 itself. Blank (and no engine) turns
# the feature off.
# CHECKLIST_AGENT_URL=http://127.0.0.1:8093
# CHECKLIST_AGENT_PORT=8093
# CHECKLIST_AGENT_MODEL=gemini-3.8-flash
# CHECKLIST_AGENT_THINKING=default
# On Cloud Run the Deploy workflow sets the Agent Engine resource name instead:
# CHECKLIST_AGENT_ENGINE=projects/PROJECT/locations/REGION/reasoningEngines/ID

# The written policy checks (data protection, responsible AI) are graded by Gemini on
# Vertex AI with the same project and credentials. Without GOOGLE_CLOUD_PROJECT, or with
# AI_MODE=document-search, they answer 503 CHECK_GRADER_UNAVAILABLE.
# CHECK_GRADER_MODEL=gemini-3.8-flash
# low (default): thinkingLevel LOW, about twice as fast; default: the model's own thinking.
# CHECK_GRADER_THINKING=low

# Optional, for npm run local (Docker): the website port on this computer.
# LOCAL_WEB_PORT=3100
