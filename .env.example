# Server-only settings. Never prefix these keys with VITE_.
# Fresh clones start with sample answers. Your existing .env is unchanged.
# For your configured company assistant, use AI_MODE=gemini-chat.
AI_MODE=demo
# Gemini runs on Vertex AI with Application Default Credentials (no API key).
# Locally run: gcloud auth application-default login
# With accounts on (DATABASE_URL), the project also enables HR profile autofill:
# Gemini pre-fills the employee forms from an uploaded CV, offer letter or form.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Legacy billed Cloud Text-to-Speech route; off by default, local use only.
# GOOGLE_CLOUD_TTS=enabled
GEMINI_MODEL=gemini-3.5-flash-lite
# Company documents: Vertex AI Search chunk search (same project and credentials).
# Leave the engine ID blank to answer from the built-in sample onboarding guide.
VERTEX_SEARCH_LOCATION=global
VERTEX_SEARCH_ENGINE_ID=
# Optional, with accounts on: a Google Drive folder whose Google Docs join HR's company
# library for signed-in chats. Drive reads need credentials with the drive.readonly scope
# (a plain `gcloud auth application-default login` has none, so Drive answers access denied).
GOOGLE_DRIVE_FOLDER_ID=
# Saved chats: blank keeps them in local SQLite (.cache/chat/conversations.sqlite).
# (default) stores them in Firestore in FIRESTORE_PROJECT_ID (or GOOGLE_CLOUD_PROJECT),
# with the same credentials. Employee accounts require it.
FIRESTORE_DATABASE_ID=
# Firestore project for saved chats and employee profiles. Blank uses GOOGLE_CLOUD_PROJECT.
# Locally use demo-onboardai, the project the Firestore emulator in compose.yaml keeps.
FIRESTORE_PROJECT_ID=
# Local Firestore emulator (npm run db:up). Required for accounts outside Cloud Run, so
# test personal data never reaches a cloud database. Locally: 127.0.0.1:8681
FIRESTORE_EMULATOR_HOST=
# HR and employee accounts: PostgreSQL connection URL. Blank turns accounts off.
# Local (compose.yaml): postgresql://onboardai:onboardai_local@127.0.0.1:5442/onboardai
# Then: npm run db:up, npm run db:migrate, npm run hr:create. Never commit a real password.
DATABASE_URL=
# Optional persistent private SQLite location when FIRESTORE_DATABASE_ID is blank.
# CHAT_DATABASE_PATH=C:/private/onboardai/conversations.sqlite
HOST=127.0.0.1
PORT=3000
# Warm the installed Kokoro model at startup for an earlier first spoken answer.
VOICE_WARMUP=true

# Optional, for npm run local (Docker): the website port on this computer.
# LOCAL_WEB_PORT=3100
