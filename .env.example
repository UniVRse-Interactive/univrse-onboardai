# Server-only settings. Never prefix secrets with VITE_.
# Keep your existing .env; set AI_MODE=gemini-chat there for company chat.
# Fresh copies use labelled sample answers until configured.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_CLOUD_PROJECT=
# Private Drive access also requires Google authentication (separate from Gemini).
# Set a local credential JSON path, or configure Application Default Credentials
# with Drive read access. Keep credential files out of version control.
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/google-credentials.json
# Set to public only for a folder and Google Docs deliberately shared with anyone.
# Public mode uses anonymous folder listing/text exports; no Google login is needed.
GOOGLE_DRIVE_ACCESS=authenticated
PORT=3000
HOST=127.0.0.1
AI_MODE=demo

# Optional persistent private database location:
# CHAT_DATABASE_PATH=/private/onboardai/conversations.sqlite
